# ============================================================================
# WGPanel 环境变量示例
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都有内置默认值，通常只需设置前两项。
# ============================================================================

# --- 初始账号 ---------------------------------------------------------------
# 首个账号的用户名。留空则使用 admin。
# 仅在数据库里一个账号都没有时生效；库中已有账号后这两个变量不再被读取，
# 之后改密码请用界面上的「账号」页。
WGP_ADMIN_USERNAME=admin

# 初始密码。留空则启动时随机生成，并在日志中打印一次（仅此一次，务必保存）。
# 生产环境请显式设置为强密码，至少 10 位且混合字母与数字/符号。
WGP_ADMIN_PASSWORD=

# --- 网络 ---------------------------------------------------------------------
# 服务端公网地址（域名或 IP）。留空时自动探测容器出口 IP。
# 该值用于生成客户端配置中的 Endpoint 字段，请设为客户端可达的地址。
WGP_PUBLIC_ENDPOINT=

# Docker 部署下通常无需修改；仅当宿主机已占用该端口时才需调整。
WGP_LISTEN_PORT=51820

# Web 面板对外端口（compose 中的映射端口在 docker-compose.yml 内配置）。
WGP_LISTEN_ADDR=0.0.0.0:8080

# --- WireGuard 核心参数 ------------------------------------------------------
# 隧道接口名，最长 15 字符。
WGP_INTERFACE=wg0

# 隧道网段。修改后已分配的客户端地址不会自动迁移，需手动调整。
WGP_ADDRESS_CIDR=10.8.0.1/24

# 接口 MTU。常见取值 1420；容器网络下建议 ≤ 宿主 MTU − 80。
WGP_MTU=1420

# 下发给客户端的 DNS，逗号分隔。
WGP_DNS=1.1.1.1,8.8.8.8

# bridge（默认）= 容器内独立 netns，不占用宿主机网络栈；
# host = 使用宿主机网络，适用于需要保留入站源地址的特殊场景。
WGP_NATIVE_MODE=bridge

# --- 数据与运行 ---------------------------------------------------------------
# 数据目录，存放 SQLite、主密钥与运行时密钥。生产环境务必挂载持久卷。
WGP_DATA_DIR=/data

# 密钥轮换周期。
WGP_SESSION_TTL=15m
WGP_REFRESH_TTL=720h

# 登录限流：窗口内允许的最大失败次数与锁定时长。
WGP_LOGIN_MAX_ATTEMPTS=5
WGP_LOGIN_LOCK_WINDOW=15m

# 状态调谐周期。期望态与内核状态不一致时会自动修复。
# 面板内的「调谐间隔」设置保存后立即生效，无需改这里或重启进程。
WGP_RECONCILE_INTERVAL=2s

# --- 监控 ---------------------------------------------------------------------
WGP_METRICS_ENABLED=true
# 采样间隔，支持 200ms ~ 10s。Peer 数量大时可调大以降 CPU。
WGP_SAMPLE_INTERVAL=1s
# 单次写库的采样批大小。
WGP_SAMPLE_BATCH=200

# 数据保留策略。
WGP_RETENTION_RAW=24h
WGP_RETENTION_MIN=168h
WGP_RETENTION_HOUR=2160h
WGP_RETENTION_DAY=17520h
WGP_AUDIT_RETENTION=4320h

# --- 日志 ---------------------------------------------------------------------
# debug | info | warn | error
WGP_LOG_LEVEL=info
# console | json（生产环境建议 json，便于采集）
WGP_LOG_FORMAT=console

# 位于反向代理之后时填写其可信来源网段（如 10.0.0.0/8、172.18.0.0/16）。
# 留空表示不信任任何代理头：真实来源 IP 取 TCP 对端。
# 不要填 0.0.0.0/0 —— 那等于让任何人伪造 X-Forwarded-For 绕过登录限流。
WGP_TRUSTED_PROXY=

# --- 安全（可选） -------------------------------------------------------------
# 刷新令牌 Cookie 是否带 Secure 标记。
# 仅当面板确实位于 TLS 反向代理之后时设为 1；直接以 HTTP 暴露时设 1 会导致登录态丢失。
WGP_COOKIE_SECURE=0

# 主密钥，用于加密存储 WireGuard 私钥。留空时在 DATA_DIR 下自动生成 master.key。
# 一旦生成请勿更换，否则历史私钥无法解密。备份时必须与数据库一同保存。
WGP_MASTER_KEY=

# JWT 签名密钥。留空时自动生成并持久化到 DATA_DIR/runtime.secret。
WGP_JWT_SECRET=

# --- 时区 ---------------------------------------------------------------------
TZ=UTC